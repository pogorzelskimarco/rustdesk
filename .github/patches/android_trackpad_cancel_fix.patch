+  /// Reset Android keyboard-trackpad state when the platform cancels a gesture.
+  /// Without this, a cancelled two-finger scroll can leave the trackpad latched
+  /// in scroll mode and suppress subsequent one-finger cursor hover movement.
+  void onPointCancelImage(PointerCancelEvent e) {
+    if (_trackpadHoverDeviceId == null ||
+        e.device != _trackpadHoverDeviceId ||
+        !_trackpadTwoFinger) {
+      return;
+    }
+
+    _trackpadTwoFinger = false;
+    _trackpadScrollUnsent = Offset.zero;
+
+    if (peerPlatform == kPeerPlatformAndroid) {
+      handlePointerEvent('touch', kMouseEventTypePanEnd, e.position);
+    }
+  }
